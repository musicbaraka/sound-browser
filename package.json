{
  "name": "sound-browser",
  "version": "0.19.0",
  "description": "Sonalogue by Elyxium Corporation Labs",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "keywords": [],
  "author": "Elyxium Corporation",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "music-metadata": "^7.14.0"
  },
  "productName": "Sonalogue",
  "private": true,
  "build": {
    "appId": "com.elyxium.soundbrowser",
    "productName": "Sonalogue",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/drag.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Sonalogue-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Sonalogue"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "musicbaraka",
        "repo": "sound-browser",
        "releaseType": "release"
      }
    ],
    "copyright": "© 2026 Elyxium Corporation",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Sonalogue-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "Sonalogue-${version}-mac-${arch}.${ext}",
      "title": "Sonalogue"
    }
  }
}
